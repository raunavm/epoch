# Shared style for Orrery figures (site/data/figs/v2).
# Figures are 6.8 in wide and shown at ~680 px (100 px/in): 1 pt = 1.39 px,
# so the smallest text (9 pt) is 12.5 px and the base text (11 pt) is 15 px.

font.family:        sans-serif
font.sans-serif:    Arial
font.size:          11
axes.labelsize:     11
xtick.labelsize:    10
ytick.labelsize:    10
legend.fontsize:    10
axes.unicode_minus: True
mathtext.fontset:   custom
mathtext.rm:        Arial
mathtext.it:        Arial:italic
mathtext.bf:        Arial:bold

text.color:         222222
axes.labelcolor:    222222
axes.edgecolor:     222222
xtick.color:        222222
ytick.color:        222222

figure.figsize:     6.8, 4.0
figure.dpi:         100
figure.facecolor:   white
figure.constrained_layout.use: True
axes.facecolor:     white
savefig.facecolor:  white
savefig.bbox:       tight
savefig.pad_inches: 0.05
svg.fonttype:       none
pdf.fonttype:       42

axes.linewidth:     0.8
axes.spines.top:    False
axes.spines.right:  False
axes.grid:          False
axes.titlesize:     11
axes.labelpad:      4

xtick.direction:    out
ytick.direction:    out
xtick.major.width:  0.8
ytick.major.width:  0.8
xtick.minor.width:  0.6
ytick.minor.width:  0.6
xtick.major.size:   3.5
ytick.major.size:   3.5

lines.linewidth:    1.5
lines.markersize:   6
errorbar.capsize:   0

legend.frameon:     False
legend.handlelength: 1.6
legend.borderaxespad: 0.3

image.cmap:         gray
